{
    "name": "amjadiqbal/filament-rankforge-lite",
    "description": "Free SEO fields for Filament 4 and 5: meta, Open Graph and Twitter tags, a live SEO and readability score, and a desktop/mobile SERP preview. Upgrades to RankForge without migrating content.",
    "keywords": [
        "laravel",
        "filament",
        "filament-plugin",
        "seo",
        "meta-tags",
        "open-graph",
        "twitter-cards",
        "serp-preview",
        "readability"
    ],
    "homepage": "https://github.com/amjadiqbal/filament-rankforge-lite",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Amjad Iqbal",
            "homepage": "https://amjad.com.pk",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^4.0|^5.0",
        "illuminate/contracts": "^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "conflict": {
        "amjadiqbal/filament-rankforge": "*"
    },
    "suggest": {
        "amjadiqbal/filament-rankforge": "The full RankForge suite (redirects, sitemaps, IndexNow, AI autofill, OG images, health dashboard). Reads the same data, so upgrading needs no content migration."
    },
    "autoload": {
        "psr-4": {
            "AmjadIqbal\\FilamentRankForge\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AmjadIqbal\\FilamentRankForge\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse --memory-limit=512M",
        "format": "pint"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AmjadIqbal\\FilamentRankForge\\RankForgeServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "support": {
        "issues": "https://github.com/amjadiqbal/filament-rankforge-lite/issues",
        "source": "https://github.com/amjadiqbal/filament-rankforge-lite"
    }
}
